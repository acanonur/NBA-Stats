exports[`RadarPath > closes a fully-populated series into one loop and matches its snapshot 1`] = `"<svg width="160" height="160" viewBox="0 0 160 160" role="presentation"><g class="hw-radar-grid"><circle cx="80" cy="80" r="16.5" fill="none" stroke="var(--hw-separator)" stroke-width="1"></circle><circle cx="80" cy="80" r="33" fill="none" stroke="var(--hw-separator)" stroke-width="1"></circle><circle cx="80" cy="80" r="49.5" fill="none" stroke="var(--hw-separator)" stroke-width="1"></circle><circle cx="80" cy="80" r="66" fill="none" stroke="var(--hw-separator)" stroke-width="1"></circle><g><line x1="80" y1="80" x2="80" y2="14" stroke="var(--hw-separator)" stroke-width="1"></line><text x="80" y="4" font-size="9" fill="var(--hw-text-tertiary)" text-anchor="middle" dominant-baseline="middle">TS%</text></g><g><line x1="80" y1="80" x2="146" y2="80" stroke="var(--hw-separator)" stroke-width="1"></line><text x="156" y="80" font-size="9" fill="var(--hw-text-tertiary)" text-anchor="middle" dominant-baseline="middle">AST%</text></g><g><line x1="80" y1="80" x2="80" y2="146" stroke="var(--hw-separator)" stroke-width="1"></line><text x="80" y="156" font-size="9" fill="var(--hw-text-tertiary)" text-anchor="middle" dominant-baseline="middle">REB%</text></g><g><line x1="80" y1="80" x2="14" y2="80.00000000000001" stroke="var(--hw-separator)" stroke-width="1"></line><text x="4" y="80.00000000000001" font-size="9" fill="var(--hw-text-tertiary)" text-anchor="middle" dominant-baseline="middle">STL%</text></g></g><g><polygon points="80,20.6 119.6,80 80,113 33.800000000000004,80 80,20.6" fill="var(--hw-chart-0)" fill-opacity="0.18" stroke="none"></polygon><polyline points="80,20.6 119.6,80 80,113 33.800000000000004,80 80,20.6" fill="none" stroke="var(--hw-chart-0)" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round"></polyline></g></svg>"`;

