// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AvailabilityExplainer > renders the headline, explanation, notes, and era timeline, and matches its snapshot 1`] = `"<div class="_backdrop_6164bd"><div class="_dialog_6164bd" role="dialog" aria-modal="true" aria-labelledby="_r_0_"><div class="_header_6164bd"><div class="_headerText_6164bd"><div id="_r_0_" class="_text_735e26 _sectionTitle_735e26">Estimated, not measured</div><div class="_text_735e26 _caption_735e26">Usage % · 1971-72</div></div><button type="button" class="_closeButton_6164bd">Done</button></div><p class="_text_735e26 _tableCell_735e26 _colorSecondary_735e26 _paragraph_6164bd">The NBA did not publish possession data before 1996-97, so Usage % for the 1971-72 season is derived from the box score with Basketball-Reference style formulas. It is a careful estimate, not a measured number, and it should not be compared with a modern figure without that caveat.</p><div class="_notes_6164bd"><span class="_text_735e26 _statLabel_735e26">What is missing here</span><div class="_note_6164bd"><span class="_text_735e26 _caption_735e26 _colorWarning_735e26">•</span><span class="_text_735e26 _tableCell_735e26 _colorSecondary_735e26">Individual turnovers were not recorded, so possessions ended are inferred.</span></div></div><div class="_timeline_6164bd"><span class="_text_735e26 _statLabel_735e26">When the record changed</span><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1946-47</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">BAA begins</div><div class="_text_735e26 _caption_735e26">Basic box score: FG, FT, PTS, PF, AST.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1950-51</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Rebounds tracked</div><div class="_text_735e26 _caption_735e26">Total rebounds only; no offensive/defensive split.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1951-52</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Minutes played tracked</div><div class="_text_735e26 _caption_735e26">Enables per-minute metrics such as PER and WS/48.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1973-74</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Steals, blocks, OREB/DREB split</div><div class="_text_735e26 _caption_735e26">First season BPM and VORP can be computed.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1977-78</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Individual turnovers tracked</div><div class="_text_735e26 _caption_735e26">Enables USG% and TOV%.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1979-80</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Three point line introduced</div><div class="_text_735e26 _caption_735e26">3PM/3PA and 3PAr begin.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">1996-97</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Advanced box scores and play-by-play</div><div class="_text_735e26 _caption_735e26">First season with true per-game ratings, plus/minus and shot charts.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">2013-14</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Player tracking league-wide</div><div class="_text_735e26 _caption_735e26">SportVU, then Sony Hawk-Eye from 2023-24.</div></div></div><div class="_timelineRow_6164bd"><span class="_text_735e26 _tableHeader_735e26 _tabularNums_735e26 _timelineSeason_6164bd">2016-17</span><div class="_timelineBody_6164bd"><div class="_text_735e26 _tableCell_735e26">Hustle stats</div><div class="_text_735e26 _caption_735e26">Box outs added around 2019-20.</div></div></div></div><p class="_text_735e26 _caption_735e26 _paragraph_6164bd">Pre-1997 advanced season numbers are Basketball-Reference style estimates from the box score, not measured possessions. Hardwood labels them rather than quietly mixing them with modern figures.</p></div></div>"`;

exports[`Card > renders its children inside the standard surface and matches its snapshot 1`] = `"<div class="_card_c3224f _paddingMd_c3224f" style="box-shadow: var(--hw-card-shadow);">Net Rating</div>"`;

exports[`StalenessDot > renders fresh (filled dot) and matches its snapshot 1`] = `"<span class="_row_4a28b6" role="status" aria-label="Updated just now"><span class="_fresh_4a28b6" aria-hidden="true"></span><span aria-hidden="true" class="_text_735e26 _caption_735e26 _colorTertiary_735e26">just now</span></span>"`;
