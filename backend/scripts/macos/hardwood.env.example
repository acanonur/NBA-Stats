# Hardwood settings for your Mac.
#
# install.sh copies this file to
#     ~/Library/Application Support/Hardwood/hardwood.env
# the first time it runs, and never overwrites it afterwards, so your edits are safe.
#
# HOW TO USE IT
#   * Every line below is a setting at its DEFAULT, switched off with a leading "#".
#     To change one, delete the "# " in front of it and edit the value.
#   * Write each setting on its own line as NAME=value. Put comments on their own lines:
#     a comment after a value becomes part of the value.
#   * No quotes are needed, even for paths with spaces. "~" is NOT expanded; write the full path.
#   * Everything is on by default. You only need this file to turn something OFF.
#
# WHEN A CHANGE TAKES EFFECT
#   * The background worker (headlines, injuries, EuroLeague, projections) re-reads this file
#     every 30 seconds. A switch below stops or starts that work within the half minute.
#   * The API and the two NBA ingest programs read it when they start. To apply a change to
#     them, run:
#         launchctl kickstart -k gui/$(id -u)/com.hardwood.api
#     (and the same with com.hardwood.nba-watch for the NBA ingest loop).
#   * A value set in the launchd plists (the folders and database paths) wins over this file.
#     Those are written by install.sh; do not set them here.
#
# This file can hold secrets (an API key). install.sh makes it readable by you only.

# -----------------------------------------------------------------------------------------
# 1. Switch a source OFF
#
# Hardwood only fetches for private use on this Mac, at a polite pace, and it says so in the
# User-Agent it sends. If a source gives you trouble, or you would simply rather not use it,
# switch it off here. Values: on / off (also 1 / 0, yes / no, true / false).
# A value that is not one of those is treated as OFF.
# -----------------------------------------------------------------------------------------

# EuroLeague live data from the EuroLeague's own data service (fixtures, results, box scores,
# rosters). Your imported workbook keeps working with this off.
# HARDWOOD_EL_LIVE=on

# The whole EuroLeague feature: its store, its routes and its background jobs.
# HARDWOOD_EL_ENABLED=on

# The NBA's official injury report (the PDF it publishes before games). It is refused
# automatically while the NBA store holds the built-in demo league.
# HARDWOOD_NBA_INJURIES=on

# News headlines (title, link, date and source name only; Hardwood never reads an article).
# Each feed's robots.txt is checked before every fetch, and a feed that disallows fetching is
# switched off by itself, with the reason shown in the Sources screen.
# HARDWOOD_NEWS=on

# -----------------------------------------------------------------------------------------
# 2. Your EuroLeague workbook
#
# Dropping a .xlsx workbook into the "inbox" folder next to this file imports it within a
# minute. That is the normal way, and the one to use. If you would rather point at a file that
# lives elsewhere, give its full path here instead. It must NOT be inside Documents, Desktop,
# Downloads or iCloud Drive: macOS hides those folders from background programs, and Hardwood
# will report that it cannot read the file.
# -----------------------------------------------------------------------------------------

# HARDWOOD_WORKBOOK_PATH=/Users/you/Workbooks/EuroLeague_2026-27_Toolkit.xlsx

# -----------------------------------------------------------------------------------------
# 3. The API
# -----------------------------------------------------------------------------------------

# Require a key on every request except the health check. Unset means anything running on this
# Mac can use the API. That is fine on a Mac only you use; set a key on a shared Mac.
# Make one with:   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# HARDWOOD_API_KEY=

# The address Hardwood believes it is served from. Leave it alone. If it is not a
# loopback address (127.0.0.1 or localhost) the worker REFUSES to fetch EuroLeague data,
# injury reports or headlines, because Hardwood is a private, personal tool and a site other
# people can reach is a different thing (docs/LEGAL.md section 2b).
# HARDWOOD_PUBLIC_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------------------
# 4. NBA ingest
# -----------------------------------------------------------------------------------------

# Seconds between scoreboard checks while games are on.
# INGEST_POLL_SECONDS=60

# How many past days the 06:10 correction pass re-pulls. The league revises box scores.
# CORRECTION_WINDOW_DAYS=3

# A proxy for the NBA requests. A Mac on a home connection does not need one.
# NBA_API_PROXY=

# -----------------------------------------------------------------------------------------
# 5. Logs and timing
# -----------------------------------------------------------------------------------------

# DEBUG, INFO or WARNING. Logs are in ~/Library/Logs/Hardwood.
# LOG_LEVEL=INFO

# How often the worker checks what is due, in seconds (5 to 300).
# HARDWOOD_WORKER_TICK_SECONDS=30
