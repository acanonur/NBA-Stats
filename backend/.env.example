# Hardwood backend — environment configuration.
#
# Copy this to `backend/.env` (`./scripts/web.sh setup` does this for you if it is missing)
# and uncomment whatever you want to change. Every line below is commented out because every
# one already has a sensible default: with this file untouched, the service runs the demo
# league at http://127.0.0.1:8000 with email-and-password sign-up in `invite` mode, and the
# Google and Apple buttons simply do not render — no greyed-out button, no "coming soon".
#
# `./scripts/web.sh doctor` prints what is configured, what is not, and why each provider is
# off. See docs/WEB.md for the full walkthrough: Google in about fifteen minutes for free,
# what Apple costs and requires, optional SMTP, and what changes before you expose this
# beyond your own machine.
#
# A blank value and a commented-out line behave the same way: the built-in default applies.
# `load_dotenv()` (nbastats/accounts/config.py) never overrides a variable your shell has
# already exported.


# ----------------------------------------------------------------------------- core service
# The stats service itself — unrelated to accounts, and present before this project had a
# web app at all. See nbastats/config.py for the authoritative list.

# SQLAlchemy URL. SQLite by default; a Postgres URL works with no code changes.
# DATABASE_URL=sqlite:///./hardwood.db

# When set, /v1 requires an `X-API-Key` header matching this value (except /v1/health, and
# except any request carrying a valid session cookie — see HARDWOOD_PUBLIC_BASE_URL below).
# HARDWOOD_API_KEY=

# Serve the seeded synthetic league and advertise it in /v1/health. scripts/serve_dev.sh
# exports this by default, which is also why account tables must never share a metadata with
# the stats tables — see nbastats/accounts/models.py.
# HARDWOOD_DEMO_MODE=1

# Override the location of contracts/*.json (metrics, widgets, presets).
# HARDWOOD_CONTRACTS_DIR=

# Optional proxy for the live NBA.com ingest path.
# NBA_API_PROXY=

# Scoreboard poll cadence, in seconds, during the live game window.
# INGEST_POLL_SECONDS=60

# The season the service treats as "latest" absent any loaded data.
# CURRENT_SEASON=2025-26

# Standard Python logging level name.
# LOG_LEVEL=INFO

# How many past days the nightly run re-pulls for stat corrections.
# CORRECTION_WINDOW_DAYS=3

# In-process rate limiting for every /v1 route (nbastats/api/deps.py). 0 disables it.
# HARDWOOD_RATE_LIMIT=600
# HARDWOOD_RATE_WINDOW_SECONDS=60


# ----------------------------------------------------------------------------- web + accounts
# Everything below is read by nbastats/accounts/config.py::AuthSettings. Nothing here is
# required to run the site — see step 1 of WEB_DESIGN.md §12 ("Run it — free, two minutes").

# The ONLY source of scheme/host/port for redirect URIs, cookie flags and the CSRF Origin
# check — never derived from a request at runtime, so a TLS-terminating proxy that reports
# `http` upstream cannot silently downgrade cookie security with no error or log line.
# Default: http://127.0.0.1:8000
# HARDWOOD_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Where the built single-page app lives. Default: <repo>/web/dist.
# HARDWOOD_WEB_DIST=

# Set to 0/false to disable mounting the web app entirely and run the API alone.
# HARDWOOD_WEB=1

# open | invite | closed. Defaults to `invite`: open signup on a non-loopback base URL is a
# startup refusal unless HARDWOOD_INVITE_CODE is also set (see §11/§4.7 of WEB_DESIGN.md).
# Mint per-invite codes with `python3 -m nbastats.accounts.admin invite`.
# HARDWOOD_SIGNUP_MODE=invite

# A single well-known invite code — mainly the required backstop for HARDWOOD_SIGNUP_MODE=open
# on a non-loopback base URL, not a substitute for `admin.py invite`.
# HARDWOOD_INVITE_CODE=

# Sliding idle-session window, in days, and the hard cap that is never extended.
# HARDWOOD_SESSION_DAYS=30
# HARDWOOD_SESSION_ABSOLUTE_DAYS=90

# scrypt's CPU/memory cost exponent (2**N). 14 is about 60 ms and 16 MiB per login here.
# HARDWOOD_SCRYPT_N=14

# Force the cookie `Secure` flag on or off. Unset (the default) derives it from whether
# HARDWOOD_PUBLIC_BASE_URL is https — leave this unset unless you have a specific reason not
# to trust that derivation.
# HARDWOOD_COOKIE_SECURE=

# Accept session cookies in clear text on a non-loopback http base URL. Off by default: the
# server refuses to start in that configuration unless this is explicitly set. Only for a
# trusted LAN you understand the risk of.
# HARDWOOD_ALLOW_INSECURE_COOKIES=0

# Include a password-reset link directly in the API response, for local development with no
# mail server — only when the requesting client is ALSO loopback, regardless of this setting.
# HARDWOOD_DEV_LINKS=0

# log (default, writes to the uvicorn log) | file (also drops an .eml into
# backend/.hardwood-mail/) | smtp.
# HARDWOOD_MAILER=log

# smtps://user:pass@host:465 or smtp+starttls://user:pass@host:587 — plain smtp:// is a
# startup refusal (a cleartext channel that can reset any account is not acceptable).
# HARDWOOD_SMTP_URL=
# HARDWOOD_MAIL_FROM=Hardwood <no-reply@example.com>

# --- Google sign-in (free, ~15 minutes; see WEB_DESIGN.md §12.2) -------------------------
# Both must be set for the Google button to appear. Authorised redirect URI must be exactly
# {HARDWOOD_PUBLIC_BASE_URL}/v1/auth/google/callback.
# HARDWOOD_GOOGLE_CLIENT_ID=
# HARDWOOD_GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple ($99/year, needs a real https domain; see WEB_DESIGN.md §12.3) ----
# All four are required, plus an https HARDWOOD_PUBLIC_BASE_URL — Apple's response_mode=
# form_post needs a SameSite=None cookie, which needs Secure, which needs https.
# HARDWOOD_APPLE_SERVICES_ID=com.hardwood.web
# HARDWOOD_APPLE_TEAM_ID=
# HARDWOOD_APPLE_KEY_ID=
# HARDWOOD_APPLE_KEY_FILE=/secure/path/AuthKey_XXXXXXXXXX.p8

# --- Reverse proxy trust -------------------------------------------------------------------
# Comma-separated CIDRs to trust X-Forwarded-* from, and how many hops to honour. The default
# (empty / 0) strips those headers from every request, so set this before putting a proxy in
# front of a non-loopback deployment or every visitor shares one rate-limit bucket.
# HARDWOOD_TRUSTED_PROXY_CIDRS=
# HARDWOOD_TRUSTED_PROXY_HOPS=0

# --- Content-Security-Policy ----------------------------------------------------------------
# Extra comma-separated img-src origins, beyond 'self'. Default: NBA's own CDN, needed for
# headshots and team logos.
# HARDWOOD_CSP_IMG_SRC=https://cdn.nba.com
