<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The macOS counterpart of Info.plist, selected by INFOPLIST_FILE[sdk=macosx*] in
	  project.pbxproj. It lives in ios/, OUTSIDE the synchronized NBAStats/ folder, for the same
	  reason Info.plist does: a plist inside that folder is copied into the bundle as a resource
	  while INFOPLIST_FILE produces the same path, and the build stops with "Multiple commands
	  produce ...".

	  GENERATE_INFOPLIST_FILE is NO, so Xcode injects nothing: the CFBundle block is required.
	  There are no iOS-only keys here (no LSRequiresIPhoneOS, UILaunchScreen, scene manifest,
	  orientations, UIBackgroundModes or BGTaskSchedulerPermittedIdentifiers): macOS has no
	  BGTaskScheduler and the launchd-run backend keeps collecting while the app is closed.

	  HardwoodAPIBaseURL is 127.0.0.1, not localhost: the backend binds IPv4 loopback only, and
	  "localhost" may resolve to ::1 first. Demo mode is OFF by default on the Mac, because the
	  Mac app is meant to read the real server on this machine.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Hardwood</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.sports</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>HardwoodAPIBaseURL</key>
	<string>http://127.0.0.1:8000/v1</string>
	<key>HardwoodDemoModeDefault</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hardwood reads statistics from its own server on this Mac or on your local network.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
